{
  "name": "brown/longbridge-php",
  "description": "Lightweight PHP client for Longbridge OpenAPI HTTP and socket protocols.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "brown",
      "email": "brownsweet9090@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.0",
    "google/protobuf": "^4.0"
  },
  "suggest": {
    "ext-swoole": "Required only when using WebSocket quote or trade clients."
  },
  "autoload": {
    "psr-4": {
      "Brown\\Longbridge\\": "src/",
      "Brown\\Longbridge\\Proto\\": "generated/Brown/Longbridge/Proto/"
    }
  }
}
